# The 7000 — environment variables
# Copy to .env.local (web) and .env (engine). Both files are gitignored.
# Never commit real values.

# ---------------------------------------------------------------------------
# Supabase
# Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email
# EMAIL_PROVIDER switches the adapter: 'brevo' today, 'resend' once a custom
# domain is verified. Nothing else in the codebase needs to change.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=

# Display name and address the digest is sent from. On Brevo's free tier this
# must be an address you have verified under Senders, Domains & Dedicated IPs.
EMAIL_FROM_NAME=The 7000
EMAIL_FROM_ADDRESS=the7000testimonies@gmail.com
# Replies land in this inbox. There is no inbound parsing — see README.
EMAIL_REPLY_TO=the7000testimonies@gmail.com

# ---------------------------------------------------------------------------
# LLM
# The engine calls whichever provider LLM_PROVIDER names. Swapping to Anthropic
# is a one-line change here, per the brief's fallback plan.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# gemini-2.5-flash (the brief's original choice) is retired for new API keys
# as of 2026-08-17 — verify current model availability at
# https://ai.google.dev/gemini-api/docs/models before relying on this value.
GEMINI_MODEL=gemini-3.5-flash
# Documented fallback if Gemini's tone/faithfulness underperforms in practice.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Groq — free tier, no credit card, OpenAI-compatible, very fast.
# Get a key at https://console.groq.com/keys
# Set LLM_PROVIDER=groq to use it instead of Gemini.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Engine behaviour
# ---------------------------------------------------------------------------
# Days back the daily job will consider an article. Brief specifies 3.
LOOKBACK_DAYS=3
# Max testimonies selected per country per edition.
MAX_PER_COUNTRY=3
# When true the job builds and stores the edition but sends the email only to
# EMAIL_TEST_RECIPIENT. Keep this on until you are happy with the output.
DRY_RUN_SEND=true
EMAIL_TEST_RECIPIENT=the7000testimonies@gmail.com

# ---------------------------------------------------------------------------
# Admin
# Only these addresses may sign in to /admin via magic link.
# ---------------------------------------------------------------------------
ADMIN_ALLOWED_EMAILS=the7000testimonies@gmail.com

# ---------------------------------------------------------------------------
# Outreach / takedown contact, surfaced on the site footer and Sources tab.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=the7000testimonies@gmail.com

# Shared secret for POST /api/revalidate, so a published edition appears on
# the site immediately rather than after the ISR window. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REVALIDATE_SECRET=
